{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://selfhelp.app/schemas/frontend-release.schema.json",
    "title": "SelfHelp frontend release (signed)",
    "description": "A signed SelfHelp frontend release: a ready-built Next.js standalone image with backend compatibility metadata. Consumed by sh-manager.",
    "type": "object",
    "required": ["kind", "id", "version", "channel", "image", "digest", "backendCompatibility", "security"],
    "additionalProperties": true,
    "properties": {
        "kind": {"const": "selfhelp-frontend-release"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "enum": ["stable", "beta", "nightly", "test"]},
        "releasedAt": {"type": "string", "description": "ISO-8601 publish timestamp stamped by assemble-release.mjs; releases published before 2026-06-12 may lack it."},
        "image": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1},
        "builtFrom": {"type": "object"},
        "backendCompatibility": {
            "type": "object",
            "required": ["requiredCoreRange", "requiredApiVersion"],
            "properties": {
                "requiredCoreRange": {"type": "string"},
                "requiredApiVersion": {"type": "string"}
            }
        },
        "security": {
            "type": "object",
            "required": ["signature", "keyId"],
            "properties": {
                "signature": {"type": "string", "minLength": 1},
                "keyId": {"type": "string", "minLength": 1},
                "signedPayload": {"type": "string"},
                "signedPayloadSha256": {"type": "string"}
            }
        },
        "blocked": {"type": "boolean"}
    }
}
